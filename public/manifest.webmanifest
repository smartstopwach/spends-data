{
  "id": "./",
  "name": "Spends Data \u2014 Expense Tracker",
  "short_name": "Spends Data",
  "description": "Track money in, daily spends and running balance. Weekly email reports, offline support, no account needed.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#f6f7f9",
  "theme_color": "#4338CA",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Add spend",
      "short_name": "Spend",
      "url": "./#home",
      "description": "Record a new spend"
    },
    {
      "name": "Transactions",
      "short_name": "History",
      "url": "./#transactions",
      "description": "View all transactions"
    },
    {
      "name": "Reports",
      "short_name": "Reports",
      "url": "./#reports",
      "description": "Send a spend report by email"
    }
  ]
